# Copie para ".env" e preencha com os valores reais (nunca commite o .env).

# Connection strings do Postgres (Neon: Dashboard do projeto > Connect).
# DATABASE_URL: a com "-pooler" no host — usada pelo app em runtime.
# DIRECT_URL: a mesma, sem "-pooler" — usada só pelas migrations do Prisma
# (o pooler roda em modo transação, que pode quebrar os advisory locks que
# o Prisma Migrate usa). Tire "channel_binding=require" se vier na string
# copiada da Neon — o engine do Prisma não entende esse parâmetro.
DATABASE_URL="postgresql://usuario:senha@ep-xxxx-pooler.regiao.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:senha@ep-xxxx.regiao.aws.neon.tech/neondb?sslmode=require"

# Porta em que a API sobe localmente.
PORT=3333

# Qualquer string aleatória longa (ex: openssl rand -hex 32). Usada para
# assinar os tokens JWT do painel do dono.
JWT_SECRET=troque-por-uma-string-aleatoria-longa

# Secret usado para proteger a rota interna de processamento de lembretes
# (POST /api/internal/lembretes/processar) — só quem tiver esse valor no
# header Authorization consegue chamá-la.
LEMBRETES_SECRET=troque-por-outra-string-aleatoria-longa

# Opcional: chave da Resend (resend.com) para enviar e-mails de verdade.
# Sem isso, o EmailService só loga o e-mail no console (modo dev).
RESEND_API_KEY=
